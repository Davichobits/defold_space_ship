function init(self)
	-- self.sound_box = gui.get_node("SoundBox")
	-- self.sound_icon = gui.get_node("Image")

	self.start_button = gui.get_node("StartButton")
	self.exit_button = gui.get_node("ExitButton")

	msg.post(".", "acquire_input_focus")

	-- sound.play("/Music#sound", {delay = 1, gain = 0.05, pan = 0, speed = 1.0})

	-- update_sound_icon(GameManager.is_sound_on)
