local max_speed = 300
local min_x = 40
local max_x = 560

-- Mensajes para la FSM
local ANIMATION_DONE = hash("animation_done")

-- Inicialización
function init(self)

	self.target_state = "idle"
	self.trigger_state = nil

	msg.post(".", "acquire_input_focus")
	self.speed = 0
	self.left_pressed = false
	self.right_pressed = false
end

-- Actualización por frame
function update(self, dt)
	local position = go.get_position()
	position.x = position.x + self.speed * dt

	-- Límites de pantalla
	if position.x <= min_x then
		position.x = min_x
		self.speed = 0
	elseif position.x >= max_x then
		position.x = max_x
		self.speed = 0
	end

	go.set_position(position)
end

-- Manejo de entrada
function on_input(self, action_id, action)
	print(
	action_id,
	action.pressed,
	action.released,
	action.repeated
)
	if action_id == hash("left") then
		if action.pressed then
			self.left_pressed = true
		elseif action.released then
			self.left_pressed = false
		end

	elseif action_id == hash("right") then
		if action.pressed then
			self.right_pressed = true
		elseif action.released then
			self.right_pressed = false
		end
	elseif action_id == hash("key_space") and action.pressed then
		local player_position = go.get_position()
		player_position.y = player_position.y + 10

		local bullet_id = factory.create("#bullet1_factory", player_position)
		local distance = 500
		local speed = 800
		local duration = distance / speed
		local to = player_position.y + distance

		go.animate(bullet_id, "position.y", go.PLAYBACK_ONCE_FORWARD, to, go.EASING_LINEAR, duration, 0, function()
			go.delete(bullet_id)
		end)
	end

	if self.left_pressed and not self.right_pressed then
		self.speed = -max_speed

	elseif self.right_pressed and not self.left_pressed then
		self.speed = max_speed

	else
		self.speed = 0
	end
end

-- Manejo de mensajes (para animaciones no loop)
function on_message(self, message_id, message)

	if message_id ~= ANIMATION_DONE then
		return
	end

end