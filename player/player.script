local max_speed = 300
local min_x = 16
local max_x = 624

local STATES = {
	idle = 1,
	left = 2,
	right = 3
}

local current_state

function init(self)
	msg.post(".", "acquire_input_focus")
	self.speed = 0
	sprite.play_flipbook("#sprite", "idle")
	current_state = STATES.idle
	self.animation = "idle"
end

function update(self, dt)
	local position = go.get_position()
	position.x = position.x + self.speed * dt

	-- Límites de pantalla
	if position.x <= min_x then
		position.x = min_x
		self.speed = 0
	elseif position.x >= max_x then
		position.x = max_x
		self.speed = 0
	end

	go.set_position(position)

	-- Sincronizar animación con el estado
	if current_state == STATES.idle and self.animation ~= "idle" then
		sprite.play_flipbook("#sprite", "idle")
		self.animation = "idle"
	elseif current_state == STATES.left and self.animation ~= "left" then
		sprite.play_flipbook("#sprite", "left")
		self.animation = "left"
	elseif current_state == STATES.right and self.animation ~= "right" then
		sprite.play_flipbook("#sprite", "right")
		self.animation = "right"
	end

	-- Debug: Imprimir el estado actual
	if current_state == STATES.idle then
		print("idle")
	elseif current_state == STATES.left then
		print("left")
	elseif current_state == STATES.right then
		print("right")
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		if action.pressed then
			change_state(STATES.left)
			self.speed = -max_speed
		elseif action.released then
			change_state(STATES.idle)
			self.speed = 0
		end
	elseif action_id == hash("right") then
		if action.pressed then
			change_state(STATES.right)
			self.speed = max_speed
		elseif action.released then
			change_state(STATES.idle)
			self.speed = 0
		end
	elseif action_id == hash("key_space") and action.pressed then
		local player_position = go.get_position()
		player_position.y = player_position.y + 10
		local bullet_id = factory.create("#bullet1_factory", player_position)
		local distance = 500
		local speed = 800
		local duration = distance/speed
		local to = player_position.y + distance
		go.animate(bullet_id, "position.y", go.PLAYBACK_ONCE_FORWARD, to, go.EASING_LINEAR, duration, 0, function()
			go.delete(bullet_id)
		end)
	end
end

function change_state(new)
	current_state = new
end