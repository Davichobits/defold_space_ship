[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 640
height = 480
high_dpi = 0
fullscreen = 0

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = Space Shooter
dependencies#0 = https://github.com/Insality/defold-event/archive/refs/tags/14.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.2.5.zip

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = nearest

